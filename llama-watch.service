[Unit]
Description=LLAMA Safety Monitor - ASCOM Alpaca SafetyMonitor Interface
Documentation=https://github.com/smartc/llama-watch
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=llama-watch
Group=llama-watch
WorkingDirectory=/var/lib/llama-watch
ExecStart=/usr/local/bin/llama-watch
Restart=on-failure
RestartSec=5s

# Environment variables
Environment="RUST_LOG=llama_watch=info,tower_http=info"

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/llama-watch

# Resource limits
LimitNOFILE=65535

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=llama-watch

[Install]
WantedBy=multi-user.target
